BOT_TOKEN=your-telegram-bot-token-here

# Опционально: без него команда /ask отвечает, что ИИ не настроен
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Опционально: без этих трёх переменных /ask не сможет отвечать на вопросы
# про содержимое чата/канала (read_chat_history). Получить API_ID/API_HASH на
# my.telegram.org, SESSION_STRING сгенерировать через scripts/telethon_login.py
TELEGRAM_API_ID=your-telegram-api-id-here
TELEGRAM_API_HASH=your-telegram-api-hash-here
TELETHON_SESSION_STRING=generate-with-scripts/telethon_login.py
